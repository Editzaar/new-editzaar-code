rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──
    // Any logged-in user can read all user profiles (needed for admin/editor lookups)
    // Users can update their own profile BUT cannot change their own role
    // Only existing staff/admin can change another user's role
    match /users/{userId} {
      allow read: if request.auth != null;

      // Allow public creation of client profiles during checkout (cannot create admin role)
      allow create: if request.auth != null || (
        request.resource.data.role == 'client'
      );
      allow update: if request.auth != null && (
        // Writing own profile: role field must stay the same as before
        (request.auth.uid == userId &&
          (!request.resource.data.keys().hasAny(['role']) ||
           request.resource.data.role == resource.data.role))
        ||
        // Any staff/editor/admin can update any user (admin panel needs this)
        resource.data.role in ['admin', 'manager', 'editor']
        ||
        // The person writing IS an admin
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null;
    }

    // ── PROJECTS ──
    // Allow prospective clients to submit project briefs (create)
    // Reading, updating, deleting requires authenticated staff/clients
    match /projects/{projectId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;

      match /chat/{msgId} {
        allow read, write: if request.auth != null;
      }
      match /revisions/{revId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── ANNOUNCEMENTS ──
    match /announcements/{annId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── SUPPORT TICKETS ──
    match /supportTickets/{ticketId} {
      allow read, write: if request.auth != null;

      match /replies/{replyId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── AGENCY SETTINGS ──
    match /agencySettings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // ── COUPONS (Public read for coupon validation on checkout) ──
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── REVIEWS (Public read, logged-in users can post) ──
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // ── CMS (Public read, logged-in write) ──
    match /cms/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── SERVICES & PRICING ──
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── PORTFOLIO ──
    match /portfolio_videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /portfolio_websites/{websiteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── TESTIMONIALS & FAQs ──
    match /cms_testimonials/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /cms_faqs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── NOTIFICATIONS ──
    match /notifications/{notifId} {
      allow read, write: if request.auth != null;
    }
  }
}

