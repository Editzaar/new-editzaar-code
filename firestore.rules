rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated users to read and write their own profile and allow admins full user control
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Projects, Chats, Announcements, Support Tickets, Settings
    match /projects/{projectId} {
      allow read, write: if request.auth != null;

      match /chat/{msgId} {
        allow read, write: if request.auth != null;
      }
      match /revisions/{revId} {
        allow read, write: if request.auth != null;
      }
    }

    match /announcements/{annId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /supportTickets/{ticketId} {
      allow read, write: if request.auth != null;

      match /replies/{replyId} {
        allow read, write: if request.auth != null;
      }
    }

    match /agencySettings/{settingId} {
      allow read, write: if request.auth != null;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /cms/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Services & Live Pricing Catalog ──
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Portfolio Videos & Websites (Work Page) ──
    match /portfolio_videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /portfolio_websites/{websiteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Testimonials & FAQs CMS ──
    match /cms_testimonials/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /cms_faqs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
